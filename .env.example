# API 基础地址，不要包含 /chat/completions 或 /responses
OPENAI_BASE_URL=https://api.atria-asi.ai/v1
# 填写服务商提供的模型名称
OPENAI_MODEL=Atria-Dawn-Preview
OPENAI_API_KEY=
# 阿里云百炼也可使用此变量；与 OPENAI_API_KEY 二选一
DASHSCOPE_API_KEY=
# 百炼可设 false 关闭思考；其他服务商留空
DASHSCOPE_ENABLE_THINKING=
# Atria 实测工具调用以 stop 结束；其他服务商默认 false
OPENAI_ALLOW_TOOL_CALLS_WITH_STOP=true
OPENAI_TIMEOUT=120
CHAT_SYSTEM_PROMPT="你是一个可靠的助手。请用清晰、准确的语言回答问题。"
