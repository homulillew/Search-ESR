{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "decision": {
          "const": "stop"
        },
        "gap": {
          "const": ""
        },
        "actions": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "decision",
        "gap",
        "actions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "decision": {
          "const": "act"
        },
        "gap": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "tool": {
                    "const": "search"
                  },
                  "query": {
                    "type": "string",
                    "description": "A standalone global search query, usually in English"
                  },
                  "k": {
                    "const": 5
                  }
                },
                "required": [
                  "tool",
                  "query",
                  "k"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "decision",
        "gap",
        "actions"
      ],
      "additionalProperties": false
    }
  ]
}
