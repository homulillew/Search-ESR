  "segments": [
    {
      "ref": "q1",
      "start": 0,
      "end": 132,
      "text": "Sometime before 1960, a couple met for the first time in London at the BBC headquarters, where one of them was working at the time. ",
      "role": "selected"
    },
    {
      "ref": "q2",
      "start": 132,
      "end": 190,
      "text": "After this meeting, they went to have tea at Vienna Café. ",
      "role": "selected"
    },
    {
      "ref": "q3",
      "start": 190,
      "end": 272,
      "text": "The couple got married in a civil ceremony in Britain and had one child together. ",
      "role": "selected"
    },
    {
      "ref": "q4",
      "start": 272,
      "end": 344,
      "text": "When they were both over 60 years old, the couple had a church wedding. ",
      "role": "selected"
    },
    {
      "ref": "q5",
      "start": 344,
      "end": 393,
      "text": "These are the life events of a political leader. ",
      "role": "selected"
    },
    {
      "ref": "q6",
      "start": 393,
      "end": 462,
      "text": "Prior to 2010, a researcher published a biography about this leader. ",
      "role": "selected"
    },
    {
      "ref": "q7",
      "start": 462,
      "end": 548,
      "text": "The researcher, who was born on the 7th of December, received a PhD in the year 1990. ",
      "role": "selected"
    }
  ],
