{
  "provider": "deepseek",
  "model": "deepseek-flash",
  "base_url": "https://api.deepseek.com",
  "credential_file": ".env.deepseek",
  "credential_field": "DEEPSEEK_API_KEY",
  "timeout_seconds": 240,
  "max_retries": 0,
  "max_workers": 8,
  "temperature_need": 0,
  "stream": false,
  "response_format": {
    "type": "json_object"
  },
  "primary_budget_preference": "omit max_tokens; validate before selecting",
  "semantic_retries": 0,
  "tool_calls_in_need_evaluation": 0
}
